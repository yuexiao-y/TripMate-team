page { background: #FAF9F6; }

/* ========== 通用 ========== */
.page { min-height: 100vh; }
.section-title { display: flex; align-items: center; margin: 36rpx 10rpx 22rpx; font-size: 30rpx; font-weight: 600; color: #333; letter-spacing: 1rpx; }
.section-bar { width: 8rpx; height: 28rpx; border-radius: 4rpx; background: #7C9C7E; margin-right: 14rpx; }
.btn-hover { opacity: 0.82; transform: scale(0.985); }

/* ========== 输入态 ========== */
.hero {
  position: relative;
  overflow: hidden;
  background: #FFFFFF;
  margin: 16rpx 32rpx 0;
  padding: 44rpx 48rpx 48rpx;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(110, 108, 98, 0.10);
}
.hero-badge {
  position: relative;
  display: inline-block;
  padding: 8rpx 22rpx;
  border-radius: 30rpx;
  background: #ECF2EA;
  color: #5F7D61; font-size: 26rpx; letter-spacing: 4rpx;
}
.hero-title { position: relative; margin-top: 18rpx; font-size: 46rpx; font-weight: bold; color: #1A1A1A; letter-spacing: 6rpx; }
.hero-sub { position: relative; margin-top: 14rpx; font-size: 26rpx; color: #8A8378; letter-spacing: 2rpx; }

.page-body { margin-top: 24rpx; padding: 0 32rpx 60rpx; position: relative; z-index: 1; }

/* ========== 双通道模式切换 ========== */
.mode-bar { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.mode-seg {
  flex: 1; text-align: center;
  padding: 18rpx 0; border-radius: 16rpx;
  background: #FFFFFF;
  border: 3rpx solid #D8D2C4;
  color: #8A8378; font-size: 26rpx; font-weight: 600; letter-spacing: 1rpx;
}
.mode-seg.on {
  background: #7C9C7E; border-color: #7C9C7E;
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(124, 156, 126, 0.28);
}
.seg-hover { opacity: 0.82; }
.mode-hint { text-align: center; font-size: 24rpx; color: #999; margin-bottom: 22rpx; }

.input-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(110, 108, 98, 0.10);
}
.input-card-title { font-size: 32rpx; font-weight: 600; color: #333; }
.input-card-example { margin-top: 14rpx; font-size: 26rpx; line-height: 40rpx; color: #999; }
.demand-input {
  margin-top: 24rpx;
  min-height: 160rpx;
  width: 100%;
  box-sizing: border-box;
  background: #FAF9F6;
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 42rpx;
}
.start-btn {
  margin-top: 28rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 46rpx;
  background: #7C9C7E;
  color: #fff; font-size: 30rpx; font-weight: 600; letter-spacing: 2rpx;
  box-shadow: 0 10rpx 24rpx rgba(124, 156, 126, 0.30);
}
.history-btn { margin-top: 20rpx; text-align: center; font-size: 26rpx; color: #7C9C7E; }

.agent-tip {
  display: flex; align-items: flex-start;
  margin-top: 26rpx; padding: 24rpx 26rpx;
  background: #ECF2EA; border-radius: 20rpx;
}
.agent-tip-tag { flex: none; margin-right: 16rpx; padding: 4rpx 14rpx; border-radius: 20rpx; background: #7C9C7E; color: #fff; font-size: 24rpx; }
.agent-tip-text { flex: 1; font-size: 26rpx; line-height: 40rpx; color: #5F5E5A; }

.example-list { display: flex; flex-direction: column; }
.example-item {
  background: #fff; border-radius: 20rpx;
  padding: 26rpx 28rpx; margin-bottom: 20rpx;
  font-size: 26rpx; line-height: 40rpx; color: #555;
  box-shadow: 0 6rpx 18rpx rgba(110, 108, 98, 0.06);
}
.ex-hover { background: #ECF2EA; }

/* ---- 引擎模式切换 ---- */
.mode-switch { display: flex; gap: 20rpx; margin-bottom: 16rpx; }
.mode-opt {
  flex: 1; padding: 22rpx 20rpx; border-radius: 22rpx;
  background: #fff; border: 2rpx solid #F1EEE4;
  box-shadow: 0 6rpx 18rpx rgba(110, 108, 98, 0.06);
  transition: all .18s ease;
}
.mode-opt.mode-on {
  border-color: transparent;
  background: #ECF2EA;
  box-shadow: 0 8rpx 22rpx rgba(124, 156, 126, 0.18);
}
.mode-name { font-size: 28rpx; font-weight: 600; color: #4A4F5C; }
.mode-opt.mode-on .mode-name { color: #5B54D8; }
.mode-desc { margin-top: 8rpx; font-size: 26rpx; color: #8A8378; }
.mode-opt.mode-on .mode-desc { color: #7C9C7E; }
.mode-hint { margin-bottom: 24rpx; font-size: 26rpx; color: #8A8378; text-align: center; }

.mock-notice { margin-top: 30rpx; font-size: 26rpx; line-height: 36rpx; color: #8A8378; text-align: center; }

/* ========== 分析中 ========== */
.analyze-card {
  margin: 60rpx 32rpx;
  background: #fff; border-radius: 28rpx;
  padding: 48rpx 36rpx;
  box-shadow: 0 12rpx 32rpx rgba(110, 108, 98, 0.10);
}
.analyze-robot {
  width: 96rpx; height: 96rpx; margin: 0 auto 20rpx;
  border-radius: 32rpx;
  background: #7C9C7E;
  color: #fff; font-size: 34rpx; font-weight: bold;
  display: flex; align-items: center; justify-content: center;
  animation: robotFloat 1.6s ease-in-out infinite;
}
@keyframes robotFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10rpx); } }
.analyze-title { text-align: center; font-size: 32rpx; font-weight: 600; color: #333; margin-bottom: 36rpx; }

.step-list { display: flex; flex-direction: column; }
.analyze-wait {
  margin-top: 28rpx; padding: 18rpx 24rpx;
  background: #ECF2EA; border-radius: 16rpx;
  font-size: 26rpx; color: #5F7D61; text-align: center;
}
.step { display: flex; align-items: center; padding: 14rpx 0; }
.step-dot {
  flex: none; width: 40rpx; height: 40rpx; border-radius: 50%;
  margin-right: 20rpx;
  display: flex; align-items: center; justify-content: center;
  background: #ECF2EA; color: #fff; font-size: 26rpx;
}
.step-label { font-size: 26rpx; color: #8A8378; line-height: 38rpx; }
.step-active .step-dot { background: #7C9C7E; animation: dotPulse 0.9s ease-in-out infinite; }
.step-active .step-label { color: #7C9C7E; font-weight: 600; }
.step-done .step-dot { background: #5F7D61; }
.step-done .step-label { color: #333; }
@keyframes dotPulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.15); } }

/* ========== 结果态 ========== */
.result-page { padding: 0 32rpx; }
.result-hero {
  margin: 32rpx 0 24rpx;
  padding: 36rpx 32rpx;
  border-radius: 28rpx;
  background: #7C9C7E;
  box-shadow: 0 12rpx 30rpx rgba(124, 156, 126, 0.24);
}
.source-badge {
  display: inline-block; margin-bottom: 14rpx;
  padding: 6rpx 18rpx; border-radius: 20rpx;
  font-size: 24rpx; letter-spacing: 1rpx;
  background: rgba(255, 255, 255, 0.22); color: #fff;
}
.source-badge.source-cloud { background: rgba(255, 255, 255, 0.30); }
.result-title { font-size: 36rpx; font-weight: bold; color: #fff; letter-spacing: 1rpx; }
.result-sub { margin-top: 12rpx; font-size: 26rpx; color: rgba(255, 255, 255, 0.75); }

.card-block {
  background: #fff; border-radius: 28rpx;
  padding: 32rpx 30rpx; margin-bottom: 26rpx;
  box-shadow: 0 8rpx 24rpx rgba(110, 108, 98, 0.07);
}
.block-title { display: flex; align-items: center; font-size: 30rpx; font-weight: 600; color: #333; margin-bottom: 24rpx; }
.block-tag { margin-left: 16rpx; padding: 4rpx 14rpx; border-radius: 18rpx; background: #F1EEE4; color: #8A8378; font-size: 24rpx; font-weight: 400; }

/* 对话气泡 */
.chat-list { display: flex; flex-direction: column; }
.msg { display: flex; margin-bottom: 18rpx; }
.msg-user { justify-content: flex-end; }
.msg-bubble {
  max-width: 76%;
  padding: 20rpx 26rpx;
  border-radius: 22rpx;
  font-size: 26rpx; line-height: 40rpx;
}
.msg-agent .msg-bubble { background: #FAF9F6; color: #444; border-top-left-radius: 8rpx; }
.msg-user .msg-bubble { background: #7C9C7E; color: #fff; border-top-right-radius: 8rpx; }

/* 已识别需求 */
.chip-grid { display: flex; flex-wrap: wrap; }
.chip-item { width: 33.3%; margin-bottom: 22rpx; display: flex; flex-direction: column; align-items: center; }
.chip-k { font-size: 26rpx; color: #9A9FB0; }
.chip-v { margin-top: 8rpx; font-size: 26rpx; font-weight: 600; color: #333; }
.assume { margin-top: 8rpx; padding-top: 20rpx; border-top: 1rpx solid #F1EEE4; }
.assume-title { font-size: 26rpx; color: #8A8378; margin-bottom: 10rpx; }
.assume-line { font-size: 26rpx; line-height: 38rpx; color: #8A8378; }

/* 合理性检查 */
.check-line { font-size: 26rpx; line-height: 40rpx; margin-bottom: 10rpx; }
.check-ok { color: #5F7D61; }
.check-bad { color: #E8A852; }

/* 每日行程 */
.day-card { border-radius: 22rpx; background: #FAF9F6; padding: 26rpx 22rpx; margin-bottom: 20rpx; }
.day-card:last-child { margin-bottom: 0; }
.day-head { display: flex; align-items: center; margin-bottom: 20rpx; }
.day-num {
  flex: none; padding: 6rpx 18rpx; border-radius: 20rpx;
  background: #7C9C7E;
  color: #fff; font-size: 26rpx; font-weight: 600;
}
.day-theme { margin-left: 16rpx; font-size: 26rpx; color: #666; }

.tl-item { display: flex; align-items: flex-start; padding: 14rpx 0; }
.tl-time { flex: none; width: 84rpx; font-size: 26rpx; color: #8A8378; padding-top: 4rpx; }
.tl-dot { flex: none; width: 18rpx; height: 18rpx; border-radius: 50%; margin: 8rpx 18rpx 0 6rpx; }
.tl-spot { background: #7C9C7E; }
.tl-food { background: #E8A852; }
.tl-traffic { background: #5F7D61; }
.tl-main { flex: 1; min-width: 0; }
.tl-title-row { display: flex; align-items: center; }
.tl-title { font-size: 28rpx; font-weight: 600; color: #333; }
.tl-type { margin-left: 12rpx; padding: 2rpx 12rpx; border-radius: 14rpx; background: #F1EEE4; font-size: 24rpx; color: #8A8378; }
.tl-sub { margin-top: 6rpx; font-size: 26rpx; color: #8A8378; }
.tl-note { margin-top: 6rpx; font-size: 26rpx; color: #8A8378; line-height: 36rpx; }
.tl-meta { margin-top: 8rpx; display: flex; align-items: center; }
.tl-cost { font-size: 26rpx; color: #E8A852; }
.cost-free { color: #5F7D61; }
.tl-stay { margin-left: 16rpx; font-size: 26rpx; color: #8A8378; }
.tl-ai { margin-left: auto; font-size: 26rpx; color: #7C9C7E; padding: 4rpx 14rpx; border-radius: 18rpx; background: rgba(127, 181, 168, 0.10); }
.tl-hover { background: #FAF9F6; border-radius: 16rpx; }
.day-remark { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx dashed #E5DED0; font-size: 26rpx; color: #8A8378; line-height: 36rpx; }

/* 交通 */
.t-group { margin-bottom: 20rpx; }
.t-group:last-child { margin-bottom: 0; }
.t-day { font-size: 26rpx; color: #8A8378; margin-bottom: 12rpx; }
.t-leg { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 18rpx; background: #FAF9F6; border-radius: 16rpx; margin-bottom: 12rpx; }
.t-route { font-size: 26rpx; color: #333; }
.t-info { font-size: 26rpx; color: #8A8378; }

/* 美食 */
.d-group { margin-bottom: 20rpx; }
.d-group:last-child { margin-bottom: 0; }
.d-day { font-size: 26rpx; color: #8A8378; margin-bottom: 12rpx; }
.d-item { display: flex; align-items: center; padding: 16rpx 18rpx; background: #FAF9F6; border-radius: 16rpx; margin-bottom: 12rpx; }
.d-meal { flex: none; width: 100rpx; font-size: 26rpx; color: #E8A852; }
.d-main { flex: 1; min-width: 0; }
.d-name { font-size: 26rpx; color: #333; }
.d-sub { margin-top: 4rpx; font-size: 26rpx; color: #8A8378; }
.d-cost { flex: none; font-size: 26rpx; color: #E8A852; }

/* 预算 */
.b-row { display: flex; align-items: center; margin-bottom: 18rpx; }
.b-name { flex: none; width: 70rpx; font-size: 26rpx; color: #666; }
.b-bar { flex: 1; height: 16rpx; border-radius: 8rpx; background: #F1EEE4; overflow: hidden; margin: 0 20rpx; }
.b-fill { height: 16rpx; border-radius: 8rpx; background: #7C9C7E; }
.b-val { flex: none; width: 110rpx; text-align: right; font-size: 26rpx; color: #333; }
.b-total { margin-top: 22rpx; padding-top: 22rpx; border-top: 1rpx solid #F1EEE4; }
.b-total-line { font-size: 26rpx; color: #666; line-height: 44rpx; }
.b-strong { font-size: 30rpx; font-weight: 600; color: #333; margin-left: 8rpx; }
.b-remain .b-strong { color: #5F7D61; }
.b-over .b-strong { color: #E0564F; }
.b-note { margin-top: 12rpx; font-size: 26rpx; line-height: 36rpx; color: #8A8378; }

/* 清单 */
.c-group { margin-bottom: 22rpx; }
.c-group:last-child { margin-bottom: 0; }
.c-group-name { font-size: 26rpx; color: #8A8378; margin-bottom: 12rpx; }
.c-item { display: flex; align-items: center; padding: 14rpx 0; }
.c-box {
  flex: none; width: 36rpx; height: 36rpx; border-radius: 12rpx;
  border: 2rpx solid #D8D2C4; margin-right: 18rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; color: #fff;
}
.c-on { background: #7C9C7E; border-color: transparent; }
.c-text { font-size: 26rpx; color: #333; }
.c-text-done { color: #B6BAC6; text-decoration: line-through; }

/* 操作区 */
.action-row { display: flex; align-items: center; margin-top: 8rpx; }
.save-btn {
  flex: 1; height: 88rpx; line-height: 88rpx; text-align: center;
  border-radius: 44rpx;
  background: #7C9C7E;
  color: #fff; font-size: 29rpx; font-weight: 600;
  box-shadow: 0 10rpx 24rpx rgba(124, 156, 126, 0.26);
}
.saved { background: #5F7D61; box-shadow: 0 10rpx 24rpx rgba(111, 162, 135, 0.24); }
.view-btn { flex: none; margin-left: 20rpx; padding: 0 28rpx; height: 88rpx; line-height: 88rpx; border-radius: 44rpx; background: #fff; color: #7C9C7E; font-size: 26rpx; }
.restart-btn { margin: 24rpx auto 0; text-align: center; font-size: 26rpx; color: #8A8378; }
.bottom-space { height: 220rpx; }

/* 路线地图入口卡 */
.map-entry {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 24rpx 28rpx;
  border-radius: 22rpx;
  background: #ECF2EA;
  border: 2rpx solid #D8D2C4;
}
.map-entry-ico { font-size: 40rpx; margin-right: 20rpx; }
.map-entry-main { flex: 1; }
.map-entry-title { font-size: 28rpx; font-weight: 700; color: #5F7D61; }
.map-entry-sub { margin-top: 4rpx; font-size: 26rpx; color: #8A8378; }
.map-entry-arrow { font-size: 40rpx; color: #B9B4A6; }

/* 底部修改输入条 */
.modify-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff;
  padding: 16rpx 24rpx 32rpx;
  box-shadow: 0 -8rpx 24rpx rgba(110, 108, 98, 0.10);
}
.quick-row { white-space: nowrap; margin-bottom: 14rpx; }
.quick-chip {
  display: inline-block;
  padding: 10rpx 22rpx; margin-right: 14rpx;
  border-radius: 26rpx; background: #FAF9F6;
  font-size: 26rpx; color: #5C5A52;
}
.modify-row { display: flex; align-items: center; }
.modify-input {
  flex: 1; height: 76rpx; min-height: 76rpx;
  background: #FAF9F6; border-radius: 38rpx;
  padding: 0 28rpx; font-size: 26rpx; color: #333;
}
.modify-send {
  flex: none; margin-left: 18rpx;
  padding: 0 34rpx; height: 76rpx; line-height: 76rpx;
  border-radius: 38rpx;
  background: #7C9C7E;
  color: #fff; font-size: 26rpx; font-weight: 600;
}

/* ===== AI 景点讲解弹层 ===== */
.spot-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(20, 24, 40, 0.45); z-index: 90; }
.spot-panel {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 91;
  background: #fff; border-radius: 36rpx 36rpx 0 0;
  padding: 32rpx 36rpx 40rpx;
  box-shadow: 0 -12rpx 40rpx rgba(40, 50, 80, 0.18);
}
.spot-head { display: flex; align-items: center; margin-bottom: 22rpx; }
.spot-badge {
  flex: none; width: 44rpx; height: 44rpx; margin-right: 16rpx;
  border-radius: 14rpx; line-height: 44rpx; text-align: center;
  font-size: 24rpx; font-weight: bold; color: #fff;
  background: #7C9C7E;
}
.spot-title { flex: 1; font-size: 32rpx; font-weight: bold; color: #222; }
.spot-close { flex: none; width: 56rpx; text-align: center; font-size: 30rpx; color: #8A8378; }
.spot-body { max-height: 52vh; }
.spot-text { font-size: 28rpx; line-height: 46rpx; color: #444; }
.spot-loading { display: flex; align-items: center; font-size: 26rpx; color: #7C9C7E; }
.spot-dot {
  width: 16rpx; height: 16rpx; margin-right: 14rpx; border-radius: 50%;
  background: #7C9C7E; animation: spot-blink 1s infinite;
}
@keyframes spot-blink { 0%, 100% { opacity: 0.25; } 50% { opacity: 1; } }
.spot-foot { margin-top: 28rpx; }
.spot-speak {
  height: 84rpx; line-height: 84rpx; text-align: center; border-radius: 42rpx;
  margin-bottom: 18rpx;
  background: #ECF2EA; color: #7C9C7E;
  font-size: 28rpx; font-weight: 600;
}
.spot-speak.speaking {
  background: #E8A852; color: #fff;
}
.spot-copy {
  height: 84rpx; line-height: 84rpx; text-align: center; border-radius: 42rpx;
  background: #7C9C7E;
  color: #fff; font-size: 28rpx; font-weight: 600;
}
