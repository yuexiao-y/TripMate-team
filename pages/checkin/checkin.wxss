.page { min-height: 100vh; background: #FAF9F6; padding: 24rpx 32rpx 240rpx; box-sizing: border-box; }

.topbar { display: flex; align-items: center; padding: 16rpx 8rpx 24rpx; }
.topbar-title { font-size: 30rpx; font-weight: bold; color: #333; }

/* 顶部分区条（横向滑动） */
.filter-bar { white-space: nowrap; margin-bottom: 20rpx; }
.chip { display: inline-block; padding: 12rpx 28rpx; margin-right: 14rpx; background: #fff; border-radius: 999rpx; font-size: 26rpx; color: #666; }
.chip-on { background: #7C9C7E; color: #fff; font-weight: bold; }

/* 缩略图网格 */
.grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.card { width: 332rpx; background: #fff; border-radius: 32rpx; margin-bottom: 24rpx; overflow: hidden; box-shadow: 0 10rpx 26rpx rgba(96, 110, 140, 0.08); }
.thumb { position: relative; width: 100%; padding-top: 100%; background: rgba(124, 156, 126, 0.06); }
.thumb-img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.thumb-empty { position: absolute; left: 0; top: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: rgba(124, 156, 126, 0.12); font-size: 72rpx; font-weight: bold; color: #7C9C7E; }
.card-title { padding: 16rpx 20rpx 4rpx; font-size: 26rpx; color: #333; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.card-trip { margin: 0 20rpx; display: inline-block; padding: 2rpx 14rpx; background: rgba(124, 156, 126, 0.12); border-radius: 8rpx; font-size: 24rpx; color: #5F7D61; }
.card-date { padding: 4rpx 20rpx 0; font-size: 26rpx; color: #7C9C7E; }
.card-loc { padding: 6rpx 20rpx 20rpx; font-size: 26rpx; color: #999; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.empty { text-align: center; color: #999; font-size: 26rpx; padding: 100rpx 0; }
.empty-sub { margin-top: 12rpx; font-size: 26rpx; color: #bbb; }

/* 底部新建打卡大按钮 */
.fab-wrap { position: fixed; left: 50%; bottom: 40rpx; transform: translateX(-50%); z-index: 9; display: flex; flex-direction: column; align-items: center; }
.fab { width: 112rpx; height: 112rpx; border-radius: 50%; background: #7C9C7E; display: flex; align-items: center; justify-content: center; box-shadow: 0 10rpx 30rpx rgba(124, 156, 126, 0.4); }
.fab-plus { color: #fff; font-size: 64rpx; font-weight: bold; line-height: 64rpx; margin-top: -8rpx; }
.fab-text { margin-top: 8rpx; font-size: 26rpx; color: #666; background: rgba(255, 255, 255, 0.92); padding: 4rpx 16rpx; border-radius: 16rpx; }

/* 弹层 */
.mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.4); z-index: 10; }
.sheet { position: absolute; left: 0; right: 0; bottom: 0; background: #fff; border-radius: 32rpx 32rpx 0 0; padding: 40rpx 32rpx 60rpx; }
.sheet-title { font-size: 30rpx; font-weight: bold; color: #333; margin-bottom: 28rpx; }
.field { background: #FAF9F6; border-radius: 16rpx; padding: 22rpx 24rpx; font-size: 28rpx; color: #333; margin-bottom: 20rpx; }
.ta { height: 140rpx; }
.form-scroll { max-height: 62vh; }
.sheet-btn { margin-top: 12rpx; background: #7C9C7E; color: #fff; font-size: 28rpx; text-align: center; padding: 24rpx 0; border-radius: 32rpx; }
.btn-off { background: #D8D2C4; }
.sheet-del { margin-top: 24rpx; text-align: center; color: #E24B4A; font-size: 26rpx; padding: 8rpx 0; }

/* 表单照片区 */
.photo-row { display: flex; flex-wrap: wrap; margin-bottom: 4rpx; }
.photo-box { position: relative; width: 150rpx; height: 150rpx; margin: 0 16rpx 16rpx 0; border-radius: 12rpx; overflow: hidden; }
.photo-img { width: 100%; height: 100%; }
.photo-del { position: absolute; right: 0; top: 0; width: 40rpx; height: 40rpx; background: rgba(0, 0, 0, 0.5); color: #fff; font-size: 26rpx; display: flex; align-items: center; justify-content: center; border-radius: 0 0 0 12rpx; }
.photo-add { width: 150rpx; height: 150rpx; border: 2rpx dashed #D8D2C4; border-radius: 12rpx; color: #7C9C7E; font-size: 56rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 16rpx; box-sizing: border-box; }

/* 日期时间行 */
.dt-row { display: flex; }
.dt-row picker { flex: 1; }
.dt-row picker + picker { margin-left: 16rpx; }

/* 定位行 */
.loc-row { display: flex; align-items: center; }
.loc-input { flex: 1; }
.loc-btn { width: 140rpx; text-align: center; margin-left: 16rpx; margin-bottom: 20rpx; padding: 22rpx 0; font-size: 26rpx; color: #7C9C7E; background: rgba(124, 156, 126, 0.12); border-radius: 16rpx; }
