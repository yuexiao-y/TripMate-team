/* pages/home/checklist/checklist.wxss */
/* TripMate · 清单工具（出行清单） */

.cl-page {
  min-height: 100vh;
  background: #FAF9F6;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

/* ---------- 顶部进度卡 ---------- */
.cl-hero {
  background: #7C9C7E;
  border-radius: 24rpx;
  padding: 36rpx 32rpx 30rpx;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(124, 156, 126, 0.30);
}

.cl-hero-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.cl-hero-title {
  font-size: 40rpx;
  font-weight: 600;
}

.cl-hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.8;
}

.cl-percent {
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1;
}

.cl-percent-unit {
  font-size: 28rpx;
  font-weight: 400;
  margin-left: 4rpx;
  opacity: 0.8;
}

.cl-progress-track {
  margin-top: 28rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.25);
  overflow: hidden;
}

.cl-progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: #ffffff;
  transition: width 0.35s ease;
}

.cl-progress-text {
  margin-top: 14rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

/* ---------- 工具栏 ---------- */
.cl-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 8rpx 16rpx;
}

.cl-toolbar-tip {
  font-size: 24rpx;
  color: #999999;
}

.cl-toolbar-actions {
  display: flex;
  gap: 16rpx;
}

.cl-btn {
  font-size: 24rpx;
  color: #7C9C7E;
  background: #ECF2EA;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
}

.cl-btn-danger {
  color: #FA5151;
  background: #fdecec;
}

/* ---------- 分组 ---------- */
.cl-group {
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(110, 108, 98, 0.05);
}

.cl-group-head {
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
}

.cl-arrow {
  font-size: 22rpx;
  color: #999999;
  margin-right: 14rpx;
  transition: transform 0.2s ease;
}

.cl-arrow-collapsed {
  transform: rotate(-90deg);
}

.cl-group-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.cl-group-count {
  font-size: 24rpx;
  color: #999999;
}

.cl-group-count-done {
  color: #7C9C7E;
  font-weight: 600;
}

.cl-group-body {
  padding: 0 28rpx 12rpx;
}

/* ---------- 条目 ---------- */
.cl-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.cl-checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  border: 3rpx solid #dddddd;
  margin-right: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.15s ease;
}

.cl-checkbox-checked {
  background: #7C9C7E;
  border-color: #7C9C7E;
}

.cl-check-mark {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.cl-item-name {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.cl-item-name-done {
  color: #bbbbbb;
  text-decoration: line-through;
}

.cl-group-empty {
  padding: 24rpx 0 16rpx;
  font-size: 24rpx;
  color: #bbbbbb;
  text-align: center;
}

/* ---------- 空状态 ---------- */
.cl-empty {
  padding: 90rpx 0 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cl-empty-icon {
  width: 120rpx; height: 120rpx;
  margin: 0 auto 24rpx;
  border-radius: 32rpx;
  background: rgba(124, 156, 126, 0.1) center / 55% no-repeat;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%235F7D61' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='7' y='7' width='10' height='13' rx='2'/><path d='M10 7V5h4v2'/><path d='M10.5 11v5M13.5 11v5'/></svg>");
}

.cl-empty-title {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.cl-empty-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999999;
}

/* ---------- 底部添加栏 ---------- */
.cl-add-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(110, 108, 98, 0.06);
}

.cl-input {
  flex: 1;
  height: 72rpx;
  background: #FAF9F6;
  border-radius: 999rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #333333;
}

.cl-input-placeholder {
  color: #bbbbbb;
}

.cl-add-group {
  margin: 0 16rpx 0 20rpx;
  font-size: 24rpx;
  color: #7C9C7E;
  background: #ECF2EA;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  max-width: 180rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cl-add-btn {
  font-size: 28rpx;
  color: #ffffff;
  background: #7C9C7E;
  padding: 14rpx 34rpx;
  border-radius: 999rpx;
}

/* 底栏占位 */
.cl-bottom-space {
  height: 140rpx;
}
