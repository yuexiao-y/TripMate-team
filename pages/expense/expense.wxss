/* pages/expense/expense.wxss —— 预算记账样式
   规格：页面背景 #FAF9F6；卡片白底、圆角 32rpx、柔和阴影；
   主题色 #7C9C7E（图标底色 12% 透明度）；标题 30rpx 加粗 #333；正文 26-28rpx */
page {
  background: #FAF9F6;
  font-size: 28rpx;
  color: #333;
}

.page {
  padding: 24rpx 24rpx 200rpx;
}

/* ===== 行程条 ===== */
.trip-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.trip-picker {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.trip-arrow {
  color: #999;
  font-size: 26rpx;
  margin-left: 6rpx;
}
.day-badge {
  background: rgba(124, 156, 126, 0.12);
  color: #7C9C7E;
  font-size: 26rpx;
  font-weight: bold;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

/* ===== 汇总卡 ===== */
.summary-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(17, 24, 39, 0.06);
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.summary-label {
  font-size: 26rpx;
  color: #999;
}
.summary-amount {
  font-size: 56rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.3;
}
.amount-over {
  color: #FA5151;
}
.summary-sub {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}
.budget-remain {
  background: rgba(124, 156, 126, 0.12);
  color: #7C9C7E;
  font-size: 26rpx;
  font-weight: bold;
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
}
.budget-remain.over {
  background: rgba(250, 81, 81, 0.12);
  color: #FA5151;
}
/* v1.3：汇总卡「我的 / 全部」口径切换 */
.summary-head {
  display: flex;
  align-items: center;
}
.view-switch {
  display: flex;
  background: #F0F1F5;
  border-radius: 999rpx;
  padding: 4rpx;
  margin-left: 16rpx;
}
.vs-btn {
  font-size: 26rpx;
  color: #999;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
}
.vs-btn.vs-on {
  background: #7C9C7E;
  color: #fff;
  font-weight: bold;
}

/* ===== Tab ===== */
.tabs {
  display: flex;
  background: #fff;
  border-radius: 32rpx;
  padding: 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(17, 24, 39, 0.06);
  margin-bottom: 24rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 24rpx;
}
.tab-active {
  background: #7C9C7E;
  color: #fff;
  font-weight: bold;
}

/* ===== 工具行（日期筛选 / 排序） ===== */
.toolbar {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.tool-chip {
  font-size: 26rpx;
  font-weight: bold;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(124, 156, 126, 0.12);
  color: #7C9C7E;
  margin-right: 16rpx;
}
.tool-chip.ghost {
  background: #fff;
  color: #666;
  box-shadow: 0 4rpx 12rpx rgba(17, 24, 39, 0.05);
}
.tool-spacer {
  flex: 1;
}

/* ===== 明细分组 ===== */
.date-group {
  margin-bottom: 24rpx;
}
.group-head {
  display: flex;
  justify-content: space-between;
  padding: 0 8rpx 12rpx;
}
.group-date {
  font-size: 26rpx;
  font-weight: bold;
  color: #666;
}
.group-total {
  font-size: 26rpx;
  color: #999;
}
.exp-card {
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(17, 24, 39, 0.06);
  overflow: hidden;
}
.swipe-wrap {
  position: relative;
  border-bottom: 1rpx solid #F0F1F5;
}
.swipe-wrap:last-child {
  border-bottom: none;
}
.swipe-del {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 128rpx;
  background: #FA5151;
  color: #fff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.swipe-content {
  position: relative;
  background: #fff;
  padding: 28rpx 32rpx;
  transform: translateX(0);
  transition: transform 0.2s ease;
}
.swipe-content.swiped {
  transform: translateX(-128rpx);
}
.exp-row {
  display: flex;
  align-items: center;
}
.cat-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: rgba(124, 156, 126, 0.12) center / 55% no-repeat;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cat-food      { background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%235F7D61' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M4 11h16a8 8 0 0 1-16 0Z'/><path d='M14 4l6 6'/></svg>"); }
.cat-transport { background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%235F7D61' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='5' y='6' width='14' height='11' rx='3'/><path d='M5 12h14'/><circle cx='8.5' cy='19' r='1.3'/><circle cx='15.5' cy='19' r='1.3'/></svg>"); }
.cat-hotel     { background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%235F7D61' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M3 19V8'/><path d='M3 15h13a4 3 0 0 1 5 3v1'/><path d='M3 19h18'/><rect x='6' y='11' width='4' height='3' rx='1'/></svg>"); }
.cat-ticket    { background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%235F7D61' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='4' y='7' width='16' height='10' rx='2'/><path d='M13 8v8' stroke-dasharray='2 3'/></svg>"); }
.cat-shopping  { background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%235F7D61' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M7 9h10l-1.2 11H8.2Z'/><path d='M9.5 9a2.5 3 0 0 1 5 0'/></svg>"); }
.cat-fun       { background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%235F7D61' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M12 4l2.2 4.8 5.2.6-3.9 3.6 1 5.1-4.5-2.5-4.5 2.5 1-5.1-3.9-3.6 5.2-.6Z'/></svg>"); }
.cat-medicine  { background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%235F7D61' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='9'/><path d='M12 8v8M8 12h8'/></svg>"); }
.cat-phone     { background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%235F7D61' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='7' y='3' width='10' height='18' rx='2.5'/><path d='M11 18.5h2'/></svg>"); }
.cat-other     { background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%235F7D61' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='9'/><path d='M8 12h.01M12 12h.01M16 12h.01'/></svg>"); }
.exp-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}
.exp-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}
.exp-sub {
  font-size: 26rpx;
  color: #999;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.exp-right {
  text-align: right;
  margin-left: 20rpx;
  flex-shrink: 0;
}
.exp-amount {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.exp-payer {
  font-size: 26rpx;
  color: #999;
  margin-top: 4rpx;
}

/* ===== 统计页卡片 ===== */
.panel-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(17, 24, 39, 0.06);
  margin-bottom: 24rpx;
}
.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.stat-row {
  display: flex;
}
.stat-cell {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.stat-label {
  font-size: 26rpx;
  color: #999;
  margin-top: 6rpx;
}

/* 预算 */
.budget-set {
  font-size: 26rpx;
  font-weight: bold;
  color: #7C9C7E;
  background: rgba(124, 156, 126, 0.12);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}
.budget-bar {
  height: 16rpx;
  background: #F0F1F5;
  border-radius: 999rpx;
  overflow: hidden;
}
.budget-bar-inner {
  height: 100%;
  background: #7C9C7E;
  border-radius: 999rpx;
  transition: width 0.3s ease;
}
.budget-bar-inner.bar-over {
  background: #FA5151;
}
.budget-line {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666;
  margin-top: 16rpx;
}
.text-green {
  color: #7C9C7E;
  font-weight: bold;
}
.text-over {
  color: #FA5151;
  font-weight: bold;
}
.budget-warn {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #FF8F1F;
  background: rgba(255, 143, 31, 0.12);
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
}
.budget-empty {
  font-size: 26rpx;
  color: #999;
}

/* 分类小计 */
.cat-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F1F5;
}
.cat-row:last-child {
  border-bottom: none;
  padding-bottom: 4rpx;
}
.cat-info {
  flex: 1;
  margin-left: 20rpx;
}
.cat-line {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
}
.cat-name {
  font-weight: bold;
  color: #333;
}
.cat-amount {
  font-weight: bold;
  color: #333;
}
.cat-bar {
  height: 10rpx;
  background: #F0F1F5;
  border-radius: 999rpx;
  margin-top: 12rpx;
  overflow: hidden;
}
.cat-bar-inner {
  height: 100%;
  background: #7C9C7E;
  border-radius: 999rpx;
}
.cat-percent {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
  text-align: right;
}

/* ===== 结算（P1） ===== */
.settle-members {
  font-size: 26rpx;
  color: #999;
}
.settle-empty {
  text-align: center;
  padding: 100rpx 40rpx;
}
.balance-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F1F5;
}
.balance-row:last-child {
  border-bottom: none;
}
.balance-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}
.balance-val {
  font-size: 26rpx;
  font-weight: bold;
}
.balance-val.in {
  color: #7C9C7E;
}
.balance-val.out {
  color: #FA5151;
}
.balance-val.zero {
  color: #999;
  font-weight: normal;
}
.settle-note {
  font-size: 26rpx;
  color: #bbb;
  margin-top: 16rpx;
  line-height: 1.6;
}
.transfer-row {
  display: flex;
  align-items: center;
  background: #FAF9F6;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}
.transfer-row:last-child {
  margin-bottom: 0;
}
.transfer-from,
.transfer-to {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}
.transfer-arrow {
  margin: 0 16rpx;
  color: #999;
}
.transfer-amount {
  margin-left: auto;
  font-size: 28rpx;
  font-weight: bold;
  color: #7C9C7E;
}

/* ===== v1.2 新增：AA 小标 / Day 切换 / 分类预算 / 成员 / 分摊开关 ===== */
.aa-badge {
  font-size: 22rpx;
  color: #7C9C7E;
  background: rgba(124, 156, 126, 0.12);
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  margin-left: 8rpx;
  vertical-align: middle;
}
.day-scroll {
  white-space: nowrap;
  margin-bottom: 24rpx;
}
.day-chip {
  display: inline-block;
  font-size: 26rpx;
  font-weight: bold;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #666;
  box-shadow: 0 4rpx 12rpx rgba(17, 24, 39, 0.05);
  margin-right: 14rpx;
}
.day-chip-on {
  background: #7C9C7E;
  color: #fff;
}
.cat-hint {
  font-size: 26rpx;
  color: #999;
}
.cat-budget-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #7C9C7E;
  background: rgba(124, 156, 126, 0.12);
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
}
.cat-percent {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}
.text-warn {
  color: #FF8F1F;
  font-weight: bold;
}
.cat-bar-inner.bar-warn {
  background: #FF8F1F;
}
.member-chips {
  display: flex;
  flex-wrap: wrap;
}
.member-chip {
  font-size: 26rpx;
  color: #333;
  background: #F0F1F5;
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
  margin-right: 14rpx;
  margin-bottom: 12rpx;
}
.settled-badge {
  font-size: 24rpx;
  color: #999;
  background: #F0F1F5;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: 10rpx;
}
.switch-row {
  justify-content: flex-start;
}
.switch-tip {
  margin-left: 20rpx;
  font-size: 26rpx;
  color: #999;
}
.panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.panel-head .panel-title {
  margin-bottom: 0;
}
.copy-last {
  font-size: 26rpx;
  font-weight: bold;
  color: #7C9C7E;
  background: rgba(124, 156, 126, 0.12);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}
.panel-hint {
  font-size: 26rpx;
  color: #bbb;
  margin: -8rpx 0 16rpx;
  padding-left: 8rpx;
}
.panel-high {
  z-index: 33;
}
.mask-high {
  z-index: 32;
}
.member-tip {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 20rpx;
}
.member-input-row {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}
.member-textarea {
  width: 100%;
  font-size: 28rpx;
  min-height: 120rpx;
  line-height: 1.6;
}

/* ===== 空态 ===== */
.empty-hero {
  text-align: center;
  padding-top: 160rpx;
}
.empty-list {
  text-align: center;
  padding: 80rpx 0;
}
.empty-emoji {
  width: 120rpx; height: 120rpx;
  margin: 0 auto 24rpx;
  border-radius: 32rpx;
  background: rgba(124, 156, 126, 0.1) center / 55% no-repeat;
}
.icon-receipt { background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%235F7D61' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='6' y='3' width='12' height='18' rx='2'/><path d='M9 8h6M9 12h6M9 16h4'/></svg>"); }
.icon-check-circle { background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%235F7D61' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='9'/><path d='M8 12l3 3 5-6'/></svg>"); }
.empty-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-top: 24rpx;
}
.empty-desc {
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
}
.empty-btn {
  margin: 40rpx auto 0;
  width: 360rpx;
}
.empty-tip {
  font-size: 26rpx;
  color: #bbb;
  margin-top: 20rpx;
}

/* ===== 浮动按钮 ===== */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 80rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #7C9C7E;
  color: #fff;
  font-size: 56rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(124, 156, 126, 0.4);
  z-index: 20;
}

/* ===== 记一笔弹层 ===== */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  opacity: 0;
  visibility: hidden;
  transition: all 0.25s ease;
  z-index: 30;
}
.mask-show {
  opacity: 1;
  visibility: visible;
}
.panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FAF9F6;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  transform: translateY(105%);
  transition: transform 0.25s ease;
  z-index: 31;
}
.panel-show {
  transform: translateY(0);
}
.panel-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 24rpx;
}
.amount-row {
  display: flex;
  align-items: baseline;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(17, 24, 39, 0.06);
}
.amount-symbol {
  font-size: 40rpx;
  font-weight: bold;
  color: #7C9C7E;
  margin-right: 12rpx;
}
.amount-input {
  flex: 1;
  font-size: 48rpx;
  font-weight: bold;
  height: 72rpx;
}

/* 分类九宫格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}
.grid-cell {
  width: 33.33%;
  box-sizing: border-box;
  padding: 8rpx;
}
.grid-inner {
  background: #fff;
  border: 3rpx solid transparent;
  border-radius: 20rpx;
  padding: 20rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.grid-inner.cell-on {
  border-color: #7C9C7E;
  background: rgba(124, 156, 126, 0.08);
}
.grid-name {
  font-size: 26rpx;
  color: #333;
  margin-top: 8rpx;
}
.grid-inner.cell-on .grid-name {
  color: #7C9C7E;
  font-weight: bold;
}

/* 表单行 */
.form-row {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}
.form-label {
  width: 120rpx;
  font-size: 26rpx;
  color: #666;
  flex-shrink: 0;
}
.form-input {
  flex: 1;
  font-size: 28rpx;
}
.form-value {
  font-size: 28rpx;
  color: #333;
}
.payer-area {
  flex: 1;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.payer-chip {
  font-size: 26rpx;
  padding: 8rpx 20rpx;
  background: #F0F1F5;
  color: #666;
  border-radius: 999rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}
.payer-chip.payer-on {
  background: rgba(124, 156, 126, 0.12);
  color: #7C9C7E;
  font-weight: bold;
}
/* v1.3：参与人快速加人按钮 */
.chip-add {
  background: rgba(124, 156, 126, 0.12);
  color: #7C9C7E;
  font-weight: bold;
}
.payer-input {
  width: 160rpx;
  font-size: 26rpx;
  border-bottom: 1rpx solid #E5E6EB;
}

/* 弹层按钮 */
.panel-btns {
  display: flex;
  margin-top: 12rpx;
}
.panel-btns button {
  flex: 1;
  margin-left: 16rpx;
  padding: 8rpx 0;
}
.panel-btns button:first-child {
  margin-left: 0;
}
.btn-main {
  background: #7C9C7E;
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 999rpx;
  line-height: 2.4;
}
.btn-ghost {
  background: #fff;
  color: #333;
  font-size: 28rpx;
  border-radius: 999rpx;
  line-height: 2.4;
}
.btn-main::after,
.btn-ghost::after {
  border: none;
}
