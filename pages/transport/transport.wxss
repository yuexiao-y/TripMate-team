/* pages/transport/transport.wxss */
.page {
  min-height: 100vh;
  background: #FAF9F6;
  padding: 24rpx 24rpx 160rpx;
  box-sizing: border-box;
}

.summary-card {
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 10rpx 26rpx rgba(124, 156, 126, 0.13);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.summary-row {
  display: flex;
  align-items: center;
}

.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
}

.summary-label {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #999999;
}

.stat-line {
  width: 1rpx;
  height: 48rpx;
  background: #eeeef2;
}

.filter-bar {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(124, 156, 126, 0.12);
  border-radius: 16rpx;
  padding: 14rpx 0;
}

.filter-label {
  font-size: 26rpx;
  color: #7C9C7E;
  font-weight: 500;
}

.filter-arrow {
  font-size: 26rpx;
  color: #7C9C7E;
  margin-left: 10rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 0;
}

.empty-icon {
  width: 120rpx; height: 120rpx;
  margin: 0 auto 24rpx;
  border-radius: 32rpx;
  background: rgba(124, 156, 126, 0.1) center / 55% no-repeat;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%235F7D61' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='5' y='6' width='14' height='11' rx='3'/><path d='M5 12h14'/><circle cx='8.5' cy='19' r='1.3'/><circle cx='15.5' cy='19' r='1.3'/></svg>");
}

.empty-text {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
  line-height: 1.6;
}

.transport-card {
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 30rpx rgba(51, 51, 51, 0.06);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.type-badge {
  display: flex;
  align-items: center;
  background: rgba(124, 156, 126, 0.12);
  border-radius: 16rpx;
  padding: 8rpx 16rpx;
}

.type-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.type-label {
  font-size: 26rpx;
  color: #7C9C7E;
  font-weight: bold;
}

.price {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.route {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
}

.route-city {
  flex: 1;
}

.route-city.right {
  text-align: right;
}

.city-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.city-time {
  font-size: 26rpx;
  color: #999999;
  margin-top: 8rpx;
}

.route-arrow {
  font-size: 32rpx;
  color: #7C9C7E;
  padding: 0 24rpx;
}

.card-bottom {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f1f3;
}

.booking-no {
  font-size: 26rpx;
  color: #666666;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #7C9C7E;
  color: #ffffff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 30rpx rgba(124, 156, 126, 0.4);
  z-index: 10;
}

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.form-panel {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx 32rpx;
  box-sizing: border-box;
  max-height: 82vh;
  display: flex;
  flex-direction: column;
}

.form-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  text-align: center;
  margin-bottom: 24rpx;
}

.form-scroll {
  flex: 1;
  max-height: 58vh;
}

.form-label {
  font-size: 26rpx;
  color: #666666;
  margin: 24rpx 0 12rpx;
}

.form-input,
.form-picker {
  background: #FAF9F6;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333333;
}

.picker-empty {
  color: #e5484d;
}

.ph {
  color: #c0c4cc;
}

.form-row {
  display: flex;
}

.form-col {
  flex: 1;
}

.form-col + .form-col {
  margin-left: 20rpx;
}

.form-actions {
  display: flex;
  margin-top: 32rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
}

.btn.ghost {
  background: #FAF9F6;
  color: #666666;
}

.btn.primary {
  background: #7C9C7E;
  color: #ffffff;
}

/* ---------- 自绘选择抽屉（替代原生 picker，大字号） ---------- */
.sheet-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
}

.sheet-panel {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 30rpx 0 calc(24rpx + env(safe-area-inset-bottom));
  z-index: 201;
}

.sheet-title {
  text-align: center;
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  padding: 8rpx 0 20rpx;
}

.sheet-list {
  max-height: 60vh;
}

.sheet-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 44rpx;
  font-size: 36rpx;
  color: #333333;
  border-top: 1rpx solid #F1EEE4;
}

.sheet-option.opt-on {
  color: #7C9C7E;
  font-weight: 600;
}

.opt-check {
  font-size: 34rpx;
  font-weight: bold;
}
